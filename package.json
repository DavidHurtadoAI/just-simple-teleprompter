{
  "name": "just-simple-teleprompter",
  "version": "0.1.0",
  "private": true,
  "description": "A deliberately simple, mobile-first teleprompter for Obsidian.",
  "author": "David Hurtado",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DavidHurtadoAI/just-simple-teleprompter.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "vitest run",
    "package": "node scripts/package-release.mjs",
    "audit:release": "node scripts/validate-release.mjs",
    "check": "npm test && npm run build && npm run package && npm run audit:release",
    "install:test": "node scripts/install-test.mjs ../../@Nexus-dev"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}

